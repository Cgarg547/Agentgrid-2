:root {
  font-family:
    Inter,
    ui-sans-serif,
    system-ui,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;

  color: #e5e7eb;
  background: #09090b;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;

  --background: #09090b;
  --sidebar: #0d0d10;
  --surface: #111216;
  --surface-hover: #16171c;
  --border: #24262d;
  --text: #e5e7eb;
  --muted: #8b8f9a;
  --accent: #8b5cf6;
  --accent-light: #a78bfa;
  --green: #22c55e;
  --yellow: #eab308;
  --red: #ef4444;
}

* {
  box-sizing: border-box;
}

html,
body,
#root {
  margin: 0;
  min-height: 100%;
  width: 100%;
}

body {
  min-height: 100vh;
  background: var(--background);
}

button {
  font: inherit;
}

button:focus-visible {
  outline: 2px solid var(--accent-light);
  outline-offset: 2px;
}